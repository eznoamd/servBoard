{
  "name": "servboard",
  "version": "0.1.0",
  "description": "Dashboard gráfica em kiosk para servidor doméstico, com slots de conteúdo plugáveis e exibição agendada.",
  "type": "module",
  "bin": {
    "servboard": "bin/servboard.js"
  },
  "scripts": {
    "start": "node bin/servboard.js serve",
    "doctor": "node bin/servboard.js doctor",
    "refresh": "node bin/servboard.js refresh",
    "show": "node bin/servboard.js show",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.2.1"
  },
  "license": "MIT"
}
