#!/bin/sh
# ~/.xinitrc do usuário kiosk — chamado pelo `startx` no login automático do tty1.
# Instalado por deploy/provision-kiosk.sh.

# Sem protetor de tela / sem apagar por inatividade: quem controla a energia da
# tela é o servBoard (liga no display.start, apaga no display.stop).
xset s off
xset s noblank
xset -dpms

# Esconde o cursor do mouse após 1s parado.
unclutter -idle 1 -root &

# Entrega DISPLAY/XAUTHORITY ao gerenciador systemd --user, para os serviços
# servboard-kiosk.service etc. conseguirem falar com o X.
systemctl --user import-environment DISPLAY XAUTHORITY

# Se o servidor reiniciou no meio da janela de exibição, sobe a dashboard já
# (os timers do systemd só disparam nos horários exatos de início/fim).
if /usr/local/bin/servboard within-window --quiet; then
  systemctl --user start servboard-web.service
fi

# Gerenciador de janelas mínimo — mantém o X vivo enquanto a sessão existir.
exec openbox-session
